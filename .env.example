# V-TACS System Environment Configuration

# Server Port
PORT=5000

# MySQL Database (Aiven Cloud / Local MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=vtacs_db
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true

# Security
JWT_SECRET=vtacs-super-secret-jwt-key-2026
JWT_EXPIRES_IN=24h

# Gemini LLM API Key (Gemini 2.5 Flash Engine)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Clerk User Authentication (Frontend)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_CLERK_PUBLISHABLE_KEY

# Routing Engine
OSRM_BASE_URL=http://router.project-osrm.org
