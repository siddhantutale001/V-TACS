# V-TACS System Environment Configuration

# Server Port
PORT=5000

# MySQL Database (Aiven Cloud / Local MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=vtacs_db
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true

# Security
JWT_SECRET=vtacs-super-secret-jwt-key-2026
JWT_EXPIRES_IN=24h

# Gemini LLM API Key (Gemini 2.5 Flash Engine)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Firebase Authentication (Frontend client/.env)
VITE_FIREBASE_API_KEY=AIzaSy_YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-app-id
VITE_FIREBASE_STORAGE_BUCKET=your-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# Routing Engine
OSRM_BASE_URL=http://router.project-osrm.org
